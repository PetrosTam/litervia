APP_NAME=Litervia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The Laravel default is the private application identity, NEVER postgres or a migrator.
# PostgreSQL 18 local provisioning is documented in database/provisioning/.
DB_CONNECTION=private
LITERVIA_DB_SSLMODE=prefer

# Runtime catalogue: research metadata only (no ordinary user writes).
LITERVIA_CATALOGUE_DB_HOST=127.0.0.1
LITERVIA_CATALOGUE_DB_PORT=5432
LITERVIA_CATALOGUE_DB_DATABASE=litervia_catalogue
LITERVIA_CATALOGUE_DB_USERNAME=litervia_catalogue_app
LITERVIA_CATALOGUE_DB_PASSWORD=

# Runtime private store: least-privileged application user.
LITERVIA_PRIVATE_DB_HOST=127.0.0.1
LITERVIA_PRIVATE_DB_PORT=5432
LITERVIA_PRIVATE_DB_DATABASE=litervia_private
LITERVIA_PRIVATE_DB_USERNAME=litervia_private_app
LITERVIA_PRIVATE_DB_PASSWORD=

# LOCAL isolated integration tests only; never aim these at runtime databases.
# Leave LITERVIA_PG_INTEGRATION unset except when intentionally running this suite.
LITERVIA_TEST_DB_HOST=127.0.0.1
LITERVIA_TEST_DB_PORT=5432
LITERVIA_CATALOGUE_TEST_APP_PASSWORD=
LITERVIA_CATALOGUE_TEST_MIGRATOR_PASSWORD=
LITERVIA_PRIVATE_TEST_APP_PASSWORD=
LITERVIA_PRIVATE_TEST_MIGRATOR_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
